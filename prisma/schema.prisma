// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// User & Auth Models (NextAuth Compatible)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER") // ADMIN, USER
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Content Management Models

model HeroSlide {
  id                String   @id @default(cuid())
  title             String
  subtitle          String?
  imageUrl          String
  linkText          String?
  linkUrl           String?
  secondaryLinkText String?
  secondaryLinkUrl  String?
  isActive          Boolean  @default(true)
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MenuItem {
  id        String     @id @default(cuid())
  label     String
  path      String?
  order     Int        @default(0)
  parentId  String?
  parent    MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id])
  children  MenuItem[] @relation("MenuHierarchy")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Show {
  id             String      @id @default(cuid())
  title          String
  slug           String      @unique // for url friendly names
  description    String?     // Rich text content
  shortDescription String?   // For cards/carousel
  imageUrl       String?
  status         String      @default("UPCOMING") // UPCOMING, CURRENT, PAST
  startDate      DateTime?
  endDate        DateTime?
  ticketLink     String?
  auditionLink   String?    // Link for auditions
  volunteerLink  String?    // Link for volunteering
  location       String?
  
  // Program Details
  isProgramActive Boolean    @default(false)
  programPdfUrl   String?    // Option A: Uploaded PDF URL
  programContent  String?    // Option B: Digital Program Content
  
  cast            CastMember[]
  photos          ShowPhoto[]
  audition        Audition? // One audition configuration per show
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model CastMember {
  id        String  @id @default(cuid())
  showId    String
  show      Show    @relation(fields: [showId], references: [id], onDelete: Cascade)
  name      String
  role      String
  bio       String?
  imageUrl  String?
  order     Int     @default(0)
}

model ShowPhoto {
  id        String   @id @default(cuid())
  showId    String
  show      Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  order     Int      @default(0)
}

model VolunteerApplication {
  id                String   @id @default(cuid())
  fullName          String
  email             String?
  phoneNumber       String?
  about             String?
  availability      String?
  additionalComments String?
  roles             String[] // Array of strings for selected roles
  status            String   @default("PENDING") // PENDING, CONTACTED, ARCHIVED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Audition Models

model Audition {
  id          String   @id @default(cuid())
  showId      String   @unique
  show        Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  
  description String?  // "What to bring", requirements, etc.
  location    String?
  isActive    Boolean  @default(true)
  
  slots       AuditionSlot[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditionSlot {
  id          String   @id @default(cuid())
  auditionId  String
  audition    Audition @relation(fields: [auditionId], references: [id], onDelete: Cascade)
  
  startTime   DateTime
  endTime     DateTime
  capacity    Int      @default(1)
  
  attendees   AuditionAttendee[]
  
  @@index([auditionId])
  @@index([startTime])
}

model AuditionAttendee {
  id          String   @id @default(cuid())
  slotId      String
  slot        AuditionSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  
  fullName    String
  email       String?
  phoneNumber String?
  desiredRole String? // Text area content
  
  createdAt   DateTime @default(now())
  
  @@index([slotId])
}
