// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// User & Auth Models (NextAuth Compatible)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER") // ADMIN, USER
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Content Management Models

model HeroSlide {
  id                String   @id @default(cuid())
  title             String
  subtitle          String?
  imageUrl          String
  linkText          String?
  linkUrl           String?
  secondaryLinkText String?
  secondaryLinkUrl  String?
  isActive          Boolean  @default(true)
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MenuItem {
  id        String     @id @default(cuid())
  label     String
  path      String?
  order     Int        @default(0)
  parentId  String?
  parent    MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id])
  children  MenuItem[] @relation("MenuHierarchy")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Show {
  id             String      @id @default(cuid())
  title          String
  slug           String      @unique // for url friendly names
  description    String?     // Rich text content
  shortDescription String?   // For cards/carousel
  imageUrl       String?
  status         String      @default("UPCOMING") // UPCOMING, CURRENT, PAST
  startDate      DateTime?
  endDate        DateTime?
  ticketLink     String?
  auditionLink   String?    // Link for auditions
  volunteerLink  String?    // Link for volunteering
  location       String?
  
  // Program Details
  isProgramActive Boolean    @default(false)
  programPdfUrl   String?    // Option A: Uploaded PDF URL
  programContent  String?    // Option B: Digital Program Content
  
  ticketPrice     Decimal?   @default(0.00)
  
  cast            CastMember[]
  photos          ShowPhoto[]
  performances    ShowPerformance[]
  audition        Audition? // One audition configuration per show
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Seat {
  id          String   @id @default(cuid())
  row         String   // A, B, ... K
  number      Int      // 1, 2, ...
  category    String   @default("STANDARD") // STANDARD, ACCESSIBLE
  isReserved  Boolean  @default(false) // For house seats if needed
  
  tickets     Ticket[]
  
  @@unique([row, number])
}

model ShowPerformance {
  id        String   @id @default(cuid())
  showId    String
  show      Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  date      DateTime
  
  tickets   Ticket[]
}

model Ticket {
  id            String          @id @default(cuid())
  performanceId String
  performance   ShowPerformance @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  seatId        String
  seat          Seat            @relation(fields: [seatId], references: [id])
  orderId       String?
  order         Order?          @relation(fields: [orderId], references: [id])
  
  status        String          @default("AVAILABLE") // AVAILABLE, HELD, SOLD
  pricePaid     Decimal?
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([performanceId, seatId]) // One ticket per seat per performance
}

model Order {
  id              String   @id @default(cuid())
  customerName    String
  customerEmail   String
  customerPhone   String
  
  totalAmount     Decimal
  status          String   @default("PENDING") // PENDING, PAID, FAILED
  paymentIntentId String?  // For tracking the fake payment
  last4           String?  // Last 4 digits of the card
  
  tickets         Ticket[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CastMember {
  id        String  @id @default(cuid())
  showId    String
  show      Show    @relation(fields: [showId], references: [id], onDelete: Cascade)
  name      String
  role      String
  bio       String?
  imageUrl  String?
  order     Int     @default(0)
}

model ShowPhoto {
  id        String   @id @default(cuid())
  showId    String
  show      Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  order     Int      @default(0)
}

model VolunteerApplication {
  id                String   @id @default(cuid())
  fullName          String
  email             String?
  phoneNumber       String?
  about             String?
  availability      String?
  additionalComments String?
  roles             String[] // Array of strings for selected roles
  status            String   @default("PENDING") // PENDING, CONTACTED, ARCHIVED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Audition Models

model Audition {
  id          String   @id @default(cuid())
  showId      String   @unique
  show        Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  
  description String?  // "What to bring", requirements, etc.
  location    String?
  isActive    Boolean  @default(true)
  
  slots       AuditionSlot[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditionSlot {
  id          String   @id @default(cuid())
  auditionId  String
  audition    Audition @relation(fields: [auditionId], references: [id], onDelete: Cascade)
  
  startTime   DateTime
  endTime     DateTime
  capacity    Int      @default(1)
  
  attendees   AuditionAttendee[]
  
  @@index([auditionId])
  @@index([startTime])
}

model AuditionAttendee {
  id          String   @id @default(cuid())
  slotId      String
  slot        AuditionSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  
  fullName    String
  email       String?
  phoneNumber String?
  desiredRole String? // Text area content
  
  createdAt   DateTime @default(now())
  
  @@index([slotId])
}

// News & Announcements
model NewsPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  imageUrl  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contact Form Submissions
model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}

// Global Site Settings
model SiteSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// Fundraisers
model Fundraiser {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  shortDescription String
  description      String
  
  locationName     String?
  address          String?
  city             String?
  state            String?
  zip              String?
  
  imageUrl         String?
  isActive         Boolean           @default(true)
  
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  events           FundraiserEvent[]
}

model FundraiserEvent {
  id           String     @id @default(cuid())
  fundraiserId String
  fundraiser   Fundraiser @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)
  
  startTime    DateTime
  endTime      DateTime?
  
  @@index([fundraiserId])
}

// Custom Pages
model Page {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Membership Applications
model MembershipApplication {
  id        String   @id @default(cuid())
  // Membership Type
  type      String   // Regular, Student, Family
  school    String?  // For Student
  grade     String?  // For Student
  
  // Contact Info
  firstName String
  lastName  String
  address   String
  city      String
  state     String
  zip       String
  phoneHome String?
  phoneCell String?
  email     String
  
  // Optional Demographics
  age       String?
  birthDate String? // Month/Day or Month/Year for family members
  
  // Privacy Options (true = DO NOT LIST)
  hideAddress Boolean @default(false)
  hidePhone   Boolean @default(false)
  hideEmail   Boolean @default(false)
  
  // Family Members (Stored as JSON for simplicity, or we could make a relation)
  // We'll use a JSON string to store an array of { name: string, birthDate: string }
  familyMembers String? 
  
  // Membership Tier / Donation
  tier          String   // e.g. "Regular Member", "Friend", "Bronze", etc.
  amount        String   // The donation amount they selected/entered
  
  createdAt DateTime @default(now())
}

// Sponsors
model Sponsor {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  websiteUrl  String?
  email       String?
  phone       String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
